rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public dictionary (readable without auth)
    match /words/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile (own data only)
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // User bookmarks
    match /userBookmarks/{docId} {
      allow read, write: if request.auth.uid != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
    }

    // Quiz results
    match /userQuizResults/{docId} {
      allow read, write: if request.auth.uid != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
    }

    // Today's quiz queue (pre-calculated)
    match /todayQuizQueue/{docId} {
      allow read: if request.auth.uid != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // User achievements
    match /userAchievements/{docId} {
      allow read, write: if request.auth.uid != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
    }

    // Master achievements (reference)
    match /achievements/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
