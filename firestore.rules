rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 単語（公開辞書）──────────────────────────────────────
    // 誰でも読み取り可。書き込みは Cloud Functions 経由のみ（管理者用）。
    match /words/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    // ── ユーザープロフィール ──────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── 検索履歴（SRS メタデータ含む）───────────────────────
    match /userSearchHistory/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // ── ブックマーク ─────────────────────────────────────────
    match /userBookmarks/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // ── クイズ結果 ───────────────────────────────────────────
    match /userQuizResults/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 今日のクイズキュー ───────────────────────────────────
    // 読み取りのみ許可。書き込みは Cloud Functions（generateQuizQueue）のみ。
    match /todayQuizQueue/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── バッジ定義（公開）──────────────────────────────────
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if false;
    }

    // ── ユーザーバッジ解除履歴 ──────────────────────────────
    // 書き込みは Cloud Functions（checkAndUnlockBadges）のみ。
    match /userAchievements/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
